<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ddelgadoS6.Views.vActualizarEstudiante"
             Title="vActualizarEstudiante">
    <VerticalStackLayout Padding="20"
                         Spacing="20">
        <Label 
            Text="ACTUALIZAR - ELIMINAR ESTUDIANTE"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontSize="20"/>

        <Grid ColumnSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            
            <Label Text="CODIGO"
                   Grid.Row="0"
                   Grid.Column="0" />
            <Entry x:Name="txtCodigo"
                   IsEnabled="False"
                   Grid.Row="0"
                   Grid.Column="1" />
            <Label Text="NOMBRE"
                   Grid.Row="1"
                   Grid.Column="0" />
            <Entry x:Name="txtNombre"
                   Placeholder="Modificar nombre"
                   Grid.Row="1"
                   Grid.Column="1" />
            <Label Text="APELLIDO"
                   Grid.Row="2"
                   Grid.Column="0" />
            <Entry x:Name="txtApellido"
                   Placeholder="Modificar apellido"
                   Grid.Row="2"
                   Grid.Column="1" />
            <Label Text="EDAD"
                   Grid.Row="3"
                   Grid.Column="0" />
            <Entry x:Name="txtEdad"
                   Placeholder="Modificar edad"
                   Grid.Row="3"
                   Grid.Column="1" />

        </Grid>
        <Grid ColumnSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button x:Name="btnActualizar"
                    Text="Actualizar"
                    Clicked="btnActualizar_Clicked"
                    Grid.Row="0"
                    Grid.Column="0" />
            <Button x:Name="btnEliminar"
                    Text="Eliminar"
                    Clicked="btnEliminar_Clicked"
                    Grid.Row="0"
                    Grid.Column="1" />

        </Grid>
    </VerticalStackLayout>
</ContentPage>